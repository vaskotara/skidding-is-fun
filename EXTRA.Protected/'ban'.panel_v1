local t1 = {}

local function u10(p1)
	-- upvalues: t1 (ref)
	local p1_2 = game.Players:FindFirstChild(p1)

	if p1_2 then
		t1[p1] = true

		local function v17(p2)
			-- upvalues: t1 (ref), p1 (ref)
			while t1[p1] do
				if p2 and p2.PrimaryPart then
					p2:SetPrimaryPartCFrame(CFrame.new(99999999, 99999999, 9999999999))
				end

				wait(0.1)
			end
		end

		p1_2.CharacterAdded:Connect(v17)

		if p1_2.Character then
			v17(p1_2.Character)
		end

		logScriptExecution(p1 .. " has been BANNED.")
	end
end
local function u11(p3)
	-- upvalues: t1 (ref)
	t1[p3] = nil

	local p3_2 = game.Players:FindFirstChild(p3)

	if p3_2 and p3_2.Character and p3_2.Character.PrimaryPart then
		p3_2.Character:SetPrimaryPartCFrame(CFrame.new(0, 0, 0))
	end

	logScriptExecution(p3 .. " has been un-banned!")
end

TextButton.MouseButton1Click:Connect(function()
	-- upvalues: TextBox (ref), u10 (ref)
	local TextBoxText = TextBox.Text

	if TextBoxText ~= "" then
		u10(TextBoxText)
	end
end)
TextButton2.MouseButton1Click:Connect(function()
	-- upvalues: TextBox (ref), u11 (ref)
	local TextBoxText = TextBox.Text

	if TextBoxText ~= "" then
		u11(TextBoxText)
	end
end)
TextButton3.MouseButton1Click:Connect(function()
	-- upvalues: Frame (ref), TextButton4 (ref)
	Frame.Visible = false
	TextButton4.Visible = true
end)
TextButton4.MouseButton1Click:Connect(function()
	-- upvalues: Frame (ref), TextButton4 (ref)
	Frame.Visible = true
	TextButton4.Visible = false
end)
