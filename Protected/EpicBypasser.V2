local function u3(p1)
	-- upvalues: t1 (ref)
	local s1 = ""

	for match in p1:lower():gmatch(".") do
		s1 = s1 .. (t1[match] or match)
	end

	return s1
end
local function u4(p2)
	if not setclipboard then
		warn("Clipboard functionality is not supported in this environment.")
	else
		setclipboard(p2)
	end
end
local function u5(p3)
	for _, v in ipairs({
		"n",
		"o",
		"p",
		"q",
		"s",
		"w"
	}) do
